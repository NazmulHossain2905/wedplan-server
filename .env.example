# Environment: development | production | test
NODE_ENV=development

# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# Database used by the app
DB_NAME=wedplan

# Frontend origin(s) allowed by CORS, comma-separated.
CLIENT_URL=http://localhost:3000

# Base URL of the app that runs Better Auth (usually the same as CLIENT_URL).
# The backend verifies access tokens against GET /api/auth/jwks there.
# Optional – defaults to the first entry in CLIENT_URL.
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode keys). Leave empty to keep the payment routes disabled.
STRIPE_SECRET_KEY=
# From the Stripe CLI or the webhook endpoint settings.
STRIPE_WEBHOOK_SECRET=
# Currency for the Premium plan (must be supported by your Stripe account).
STRIPE_CURRENCY=bdt

# Premium plan: price in whole currency units and access length in days.
PREMIUM_PRICE=4999
PREMIUM_DURATION_DAYS=30
